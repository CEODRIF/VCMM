# ClipForge AI - environment variables (PLACEHOLDERS ONLY)
#
# Copy this file to .env.local for local development.
# NEVER commit real values. .env* files are gitignored.
#
# ---------------------------------------------------------------------------
# Frontend (exposed to the browser - public values only)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-only (never exposed to the client)
# ---------------------------------------------------------------------------
# Supabase project URL (same value as NEXT_PUBLIC_SUPABASE_URL)
SUPABASE_URL=
# Supabase service-role key. SERVER ONLY. Never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=
# SHA-256 hash of the shared access code (plaintext never stored).
# Required for POST /api/access to work (503 when missing).
# Format: bare hex digest, or "sha256:<hex>".
# Generate one with:
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR_CODE').digest('hex'))"
ACCESS_CODE_HASH=
 # Optional direct Postgres connection string (Supabase session pooler).
 DATABASE_URL=

 # ---------------------------------------------------------------------------
 # Upload / media infrastructure limits (Next.js server, Phase 3)
 # ---------------------------------------------------------------------------
 # Hard cap for a single source upload, in bytes (default 2147483648 = 2 GiB).
 MAX_UPLOAD_SIZE_BYTES=
 # Infrastructure limit for SOURCE video duration in seconds (default 28800
 # = 8h). NOT the 60-180s requested clip length — a source may be any length
 # within this limit.
 MAX_SOURCE_DURATION_SECONDS=
 # Upload-authorization TTL in seconds (default 900 = 15 min). Our own TTL is
 # enforced at /upload/complete; it is deliberately stricter than Supabase's
 # signed-URL validity (2h).
 UPLOAD_AUTH_TTL_SECONDS=

 # ---------------------------------------------------------------------------
 # Worker (separate service, see worker/README.md)
 # ---------------------------------------------------------------------------
 WORKER_ENVIRONMENT=development
 WORKER_LOG_LEVEL=INFO
 # Scratch space only — NEVER durable storage. Supabase Storage is the source
 # of truth; worker temp files are deleted after each job.
 WORKER_STORAGE_ROOT=./worker/storage
 # Supabase project for the worker (server-side credentials, same project as
 # the API). The ingestion loop starts only when BOTH are set.
 WORKER_SUPABASE_URL=
 WORKER_SUPABASE_SERVICE_ROLE_KEY=
 # Seconds between claim attempts when the queue is idle (default 2).
 WORKER_POLL_INTERVAL=
 # Jobs processed concurrently (default 2; 1-16).
 WORKER_CONCURRENCY=
 # Lease granted per claimed job, in seconds (default 300; 30-3600). Workers
 # renew it while processing; expired leases are recovered by other workers.
 WORKER_JOB_LEASE_SECONDS=
  # Reference retry budget; the authoritative limit is the jobs.max_attempts
  # column (DB default 3). 1-10.
  WORKER_MAX_ATTEMPTS=

  # ---------------------------------------------------------------------------
  # Worker — Phase 4 transcription / analysis (local Whisper engine)
  # ---------------------------------------------------------------------------
  # Local Whisper model (tiny, base, small, medium, large-v3, ...).
  # EMPTY/absent = transcription DISABLED: analysis jobs fail honestly with the
  # permanent 'transcription_unavailable' error (never fake output). Requires
  # the optional deps:  pip install -r worker/requirements-optional.txt
  # (av must stay < 16 — see the note in that file).
  WORKER_WHISPER_MODEL=
  # Force a transcription language (e.g. en, fr). Empty = auto-detect.
  WORKER_TRANSCRIPTION_LANGUAGE=
  # Long-recording chunking: chunk length + overlap between chunks. The
  # overlap keeps sentences whole across boundaries. overlap < chunk.
  WORKER_TRANSCRIPTION_CHUNK_SECONDS=
  WORKER_TRANSCRIPTION_OVERLAP_SECONDS=
  # Whisper runtime (local CPU inference by default).
  WORKER_WHISPER_DEVICE=
  WORKER_WHISPER_COMPUTE_TYPE=
  # Audio extraction format / timeout.
  WORKER_AUDIO_SAMPLE_RATE=
  WORKER_AUDIO_EXTRACT_TIMEOUT_SECONDS=


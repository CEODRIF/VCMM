# ClipForge AI - environment variables (PLACEHOLDERS ONLY)
#
# Copy this file to .env.local for local development.
# NEVER commit real values. .env* files are gitignored.
#
# ---------------------------------------------------------------------------
# Frontend (exposed to the browser - public values only)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-only (never exposed to the client)
# ---------------------------------------------------------------------------
# Supabase project URL (same value as NEXT_PUBLIC_SUPABASE_URL)
SUPABASE_URL=
# Supabase service-role key. SERVER ONLY. Never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=
# SHA-256 hash of the shared access code (plaintext never stored).
# Set server-side in Phase 2 when access control is implemented.
ACCESS_CODE_HASH=
# Optional direct Postgres connection string (Supabase session pooler).
DATABASE_URL=

# ---------------------------------------------------------------------------
# Worker (separate service, see worker/README.md)
# ---------------------------------------------------------------------------
WORKER_ENVIRONMENT=development
WORKER_LOG_LEVEL=INFO
WORKER_STORAGE_ROOT=./worker/storage
